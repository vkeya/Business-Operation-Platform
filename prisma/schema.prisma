model AuditEvent {
  id String @id @default(cuid())

  // Tenant context
  businessId String?
  actorId    String?

  // Event classification
  action   String
  category String @default("BUSINESS")
  severity String @default("INFO")
  outcome  String @default("SUCCESS")

  // Entity affected
  entityType String
  entityId   String?

  // State changes
  beforeData Json?
  afterData  Json?

  // Request context
  ipAddress     String?
  userAgent     String?
  requestId     String?
  correlationId String?

  // Additional context
  metadata Json?

  createdAt DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([businessId, action])
  @@index([businessId, category])
  @@index([businessId, severity])
  @@index([businessId, outcome])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

