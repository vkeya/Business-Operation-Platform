generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                  String                     @id @default(cuid())
  name                String
  legalName           String?
  type                String
  country             String
  baseCurrency        String
  language            String
  timezone            String
  status              BusinessStatus             @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  logoUrl             String?
  accounts            Account[]
  taxConfiguration    TaxConfiguration?
  paymentAttempts     PaymentAttempt[]
  auditEvents         AuditEvent[]
  branches            Branch[]
  events              BusinessEvent[]
  memberships         BusinessMembership[]
  referenceCounters   BusinessReferenceCounter[]
  invitations         BusinessUserInvitation[]
  customers           Customer[]
  exchangeRates       ExchangeRate[]
  expenses            Expense[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  inventoryContainers InventoryContainer[]
  journalEntries      JournalEntry[]
  operationRequests   OperationRequest[]
  payments            Payment[]
  refunds             PaymentRefund[]
  mpesaConfiguration  MpesaConfiguration?
  products            Product[]
  productCategories   ProductCategory[]
  purchases           Purchase[]
  recipes             Recipe[]
  recipeIngredients   RecipeIngredient[]
  restaurantMenus     RestaurantMenu[]
  restaurantMenuItems RestaurantMenuItem[]
  roles               Role[]
  sales               Sale[]
  saleReturns         SaleReturn[]
  suppliers           Supplier[]
  warehouses          Warehouse[]

  subscription BusinessSubscription?

  billingInvoices BillingInvoice[]
  billingPayments BillingPayment[]

  pharmacyProfile PharmacyProfile?

  supermarketProfile SupermarketProfile?

  supermarketAutopilotActions SupermarketAutopilotAction[]

  pharmacyPrescriptions               PharmacyPrescription[]
  pharmacyControlledDispensingRecords PharmacyControlledDispensingRecord[]

  @@index([status])
}

model BusinessSubscription {
  id             String             @id @default(cuid())
  businessId     String             @unique
  plan           SubscriptionPlan
  status         SubscriptionStatus
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?

  billingCycle       BillingCycle?
  billingCurrency String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  cancelAtPeriodEnd  Boolean      @default(false)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoices  BillingInvoice[]
  addOns    BusinessSubscriptionAddOn[]

  @@index([status])
  @@index([trialEndsAt])
}

model BillingInvoice {
  id             String               @id @default(cuid())
  businessId     String
  subscriptionId String

  invoiceNumber String
  status        BillingInvoiceStatus @default(DRAFT)

  plan        SubscriptionPlan
  billingCycle BillingCycle

  type BillingInvoiceType

  currency String

  subtotal    Decimal @db.Decimal(18, 4)
  taxAmount   Decimal @db.Decimal(18, 4)
  totalAmount Decimal @db.Decimal(18, 4)
  amountPaid  Decimal @default(0) @db.Decimal(18, 4)
  amountDue   Decimal @db.Decimal(18, 4)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  periodStart DateTime?
  periodEnd   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  items    BillingInvoiceItem[]
  payments BillingPayment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
}

model BillingInvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  quantity  Decimal @default(1) @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  taxRate   Decimal @default(0) @db.Decimal(8, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)

  totalAmount Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingPayment {
  id        String @id @default(cuid())
  businessId String
  invoiceId  String

  amount   Decimal @db.Decimal(18, 4)
  currency String

  status BillingPaymentStatus @default(PENDING)

  provider          String
  providerReference String?
  providerResponse Json?

  failureReason String?

  initiatedAt  DateTime  @default(now())
  processedAt  DateTime?
  failedAt     DateTime?
  cancelledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([invoiceId])
  @@index([status])
  @@index([provider])
  @@index([providerReference])
  @@index([createdAt])
}

model SubscriptionAddOn {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  billingType SubscriptionAddOnBillingType
  active      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions BusinessSubscriptionAddOn[]

  @@index([active])
}

model BusinessSubscriptionAddOn {
  id                    String   @id @default(cuid())
  businessSubscriptionId String
  addOnCode             String
  quantity              Int      @default(1)
  status                SubscriptionAddOnStatus
  startedAt             DateTime @default(now())
  endedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription BusinessSubscription @relation(fields: [businessSubscriptionId],references: [id],onDelete: Cascade)

  addOn SubscriptionAddOn @relation(fields: [addOnCode],references: [code])

  @@unique([businessSubscriptionId, addOnCode])
  @@index([businessSubscriptionId])
  @@index([addOnCode])
  @@index([status])
}

model PharmacyProfile {
  id         String @id @default(cuid())
  businessId String @unique

  pharmacyName       String
  licenseNumber      String?
  registrationNumber String?
  pharmacistInCharge String?
  phone              String?
  email              String?
  address            String?
  city               String?
  country            String  @default("Kenya")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SupermarketProfile {
  id         String @id @default(cuid())
  businessId String @unique

  storeType                String  @default("SUPERMARKET")
  weightedProductsEnabled  Boolean @default(false)
  batchTrackingEnabled     Boolean @default(true)
  expiryTrackingEnabled    Boolean @default(true)
  loyaltyEnabled           Boolean @default(false)
  promotionsEnabled        Boolean @default(true)
  autoReplenishmentEnabled Boolean @default(true)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SupermarketAutopilotAction {
  id         String @id @default(cuid())
  businessId String

  actionType  String
  productId   String?
  productName String
  sku         String?

  priority String
  title    String
  reason   String
  source   String
  score    Decimal @db.Decimal(10, 4)

  evidence Json?

  status SupermarketAutopilotActionStatus @default(PENDING)

  snoozedUntil DateTime?
  acceptedAt   DateTime?
  dismissedAt  DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessId, actionType])
  @@index([productId])
}

model PharmacyProduct {
  id               String                   @id @default(cuid())
  productId        String                   @unique
  batches          PharmacyBatch[]
  medicineType     PharmacyMedicineType
  prescriptionType PharmacyPrescriptionType @default(OTC)

  activeIngredient      String?
  strength              String?
  dosageForm            String?
  routeOfAdministration String?

  manufacturer       String?
  registrationNumber String?
  packSize           String?

  status PharmacyProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  controlledDispensingRecords PharmacyControlledDispensingRecord[]

  @@index([medicineType])
  @@index([prescriptionType])
  @@index([status])
  @@index([manufacturer])
}

model PharmacyBatch {
  id                String @id @default(cuid())
  pharmacyProductId String
  warehouseId       String

  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime

  supplierId     String?
  purchaseId     String?
  purchaseItemId String?

  quantityReceived  Decimal @db.Decimal(18, 4)
  quantityRemaining Decimal @db.Decimal(18, 4)

  unitCost Decimal? @db.Decimal(18, 4)

  isRecalled   Boolean @default(false)
  recallReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  controlledDispensingRecords PharmacyControlledDispensingRecord[]

  pharmacyProduct PharmacyProduct @relation(fields: [pharmacyProductId], references: [id], onDelete: Cascade)

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([pharmacyProductId, batchNumber])
  @@index([pharmacyProductId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([isRecalled])
}

model PharmacyPrescription {
  id                 String                     @id @default(cuid())
  businessId         String
  customerId         String?
  saleId             String?
  prescriptionNumber String
  prescriptionDate   DateTime
  expiryDate         DateTime?
  prescriberName     String
  prescriberLicense  String?
  diagnosis          String?
  notes              String?
  status             PharmacyPrescriptionStatus @default(ACTIVE)
  createdBy          String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  business Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sale     Sale?                      @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items    PharmacyPrescriptionItem[]

  saleItems SaleItem[]

  controlledDispensingRecords PharmacyControlledDispensingRecord[]

  @@unique([businessId, prescriptionNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([saleId])
  @@index([prescriptionDate])
  @@index([expiryDate])
  @@index([status])
}

model PharmacyPrescriptionItem {
  id                 String   @id @default(cuid())
  prescriptionId     String
  productId          String
  quantityPrescribed Decimal  @db.Decimal(18, 4)
  quantityDispensed  Decimal  @default(0) @db.Decimal(18, 4)
  dosageInstructions String?
  duration           String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  saleItems SaleItem[]

  prescription PharmacyPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  controlledDispensingRecords PharmacyControlledDispensingRecord[]

  @@index([prescriptionId])
  @@index([productId])
}

model PharmacyControlledDispensingRecord {
  id                 String                         @id @default(cuid())
  businessId         String
  saleId             String
  saleItemId         String
  pharmacyProductId  String
  pharmacyBatchId    String
  prescriptionId     String?
  prescriptionItemId String?
  customerId         String?
  quantity           Decimal                        @db.Decimal(18, 4)
  dispensedBy        String
  pharmacistName     String?
  pharmacistLicense  String?
  registerReference  String?
  reason             String?
  status             PharmacyControlledRecordStatus @default(DISPENSED)
  dispensedAt        DateTime                       @default(now())
  reversedAt         DateTime?
  reversalReason     String?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)

  saleItem SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  pharmacyProduct PharmacyProduct @relation(fields: [pharmacyProductId], references: [id], onDelete: Restrict)

  pharmacyBatch PharmacyBatch @relation(fields: [pharmacyBatchId], references: [id], onDelete: Restrict)

  prescription PharmacyPrescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  prescriptionItem PharmacyPrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([saleId])
  @@index([saleItemId])
  @@index([pharmacyProductId])
  @@index([pharmacyBatchId])
  @@index([prescriptionId])
  @@index([prescriptionItemId])
  @@index([customerId])
  @@index([dispensedBy])
  @@index([dispensedAt])
  @@index([status])
  @@index([registerReference])
}

model MpesaConfiguration {
  id         String @id @default(cuid())
  businessId String @unique

  merchantType MpesaMerchantType
  shortcode    String

  environment MpesaEnvironment @default(SANDBOX)

  consumerKey             String
  encryptedConsumerSecret String
  encryptedPasskey        String

  isActive   Boolean   @default(true)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([shortcode])
}

model TaxConfiguration {
  id String @id @default(cuid())

  businessId String @unique

  enabled     Boolean        @default(false)
  name        String         @default("VAT")
  rate        Decimal        @default(0) @db.Decimal(8, 4)
  pricingMode TaxPricingMode @default(EXCLUSIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Branch {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  code           String
  address        String?
  city           String?
  country        String
  currency       String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  journalEntries JournalEntry[]
  purchases      Purchase[]
  sales          Sale[]
  users          UserBranch[]
  warehouses     Warehouse[]

  @@unique([businessId, code])
  @@index([businessId])
}

model Warehouse {
  id                  String               @id @default(cuid())
  businessId          String
  branchId            String?
  name                String
  code                String
  address             String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  purchases           Purchase[]
  sales               Sale[]
  inventoryContainers InventoryContainer[]
  saleReturns         SaleReturn[]
  branch              Branch?              @relation(fields: [branchId], references: [id])
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  pharmacyBatches PharmacyBatch[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([branchId])
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String                   @unique
  isActive                Boolean                  @default(true)
  emailVerifiedAt         DateTime?
  passwordChangedAt       DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  passwordHash            String?
  authIdentities          AuthIdentity[]
  memberships             BusinessMembership[]
  branches                UserBranch[]
  roles                   UserRole[]
  legalAcceptances        LegalAcceptance[]
  dataSubjectRequests     DataSubjectRequest[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([email])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  isOwner    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessUserInvitation {
  id         String    @id @default(cuid())
  businessId String
  email      String
  name       String?
  roleId     String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@index([roleId])
}

model Role {
  id           String                   @id @default(cuid())
  businessId   String
  name         String
  description  String?
  permissions  String[]
  isSystemRole Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  invitations  BusinessUserInvitation[]
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users        UserRole[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model ProductCategory {
  id          String            @id @default(cuid())
  businessId  String
  name        String
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    Product[]
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([parentId])
}

model Product {
  id                 String              @id @default(cuid())
  businessId         String
  categoryId         String?
  name               String
  sku                String
  barcode            String?
  type               ProductType
  description        String?
  unit               String
  costPrice          Decimal             @db.Decimal(18, 4)
  sellingPrice       Decimal             @db.Decimal(18, 4)
  currency           String
  taxRate            Decimal?            @db.Decimal(8, 4)
  taxCode            String?
  trackInventory     Boolean             @default(true)
  inventoryMode      InventoryMode       @default(DISCRETE)
  minimumStock       Decimal?            @db.Decimal(18, 4)
  reorderLevel       Decimal?            @db.Decimal(18, 4)
  status             BusinessStatus      @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attributes         Json?
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]

  inventoryContainers InventoryContainer[]

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ProductCategory?     @relation(fields: [categoryId], references: [id])
  prices              ProductPrice[]
  sellingUnits        ProductSellingUnit[]
  recipeIngredients   RecipeIngredient[]
  restaurantMenuItems RestaurantMenuItem[]

  pharmacyProduct           PharmacyProduct?
  pharmacyPrescriptionItems PharmacyPrescriptionItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([categoryId])
  @@index([barcode])
}

model ProductSellingUnit {
  id                 String     @id @default(cuid())
  productId          String
  name               String
  quantity           Decimal    @db.Decimal(18, 4)
  unit               String
  conversionQuantity Decimal?   @db.Decimal(18, 4)
  conversionUnit     String?
  sellingPrice       Decimal    @db.Decimal(18, 4)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  product            Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems          SaleItem[]

  @@unique([productId, name, quantity, unit])
  @@index([productId])
}

model ProductPrice {
  id        String           @id @default(cuid())
  productId String
  type      ProductPriceType
  price     Decimal          @db.Decimal(18, 4)
  currency  String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([productId])
}

model RestaurantMenu {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       RestaurantMenuItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model RestaurantMenuItem {
  id           String         @id @default(cuid())
  businessId   String
  menuId       String
  productId    String?
  name         String
  description  String?
  sellingPrice Decimal        @db.Decimal(18, 4)
  currency     String
  isAvailable  Boolean        @default(true)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  recipe       Recipe?
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menu         RestaurantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product      Product?       @relation(fields: [productId], references: [id])
  saleItems    SaleItem[]

  @@index([businessId])
  @@index([menuId])
  @@index([productId])
}

model Recipe {
  id          String             @id @default(cuid())
  businessId  String
  menuItemId  String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([businessId])
}

model RecipeIngredient {
  id         String   @id @default(cuid())
  businessId String
  recipeId   String
  productId  String
  quantity   Decimal  @db.Decimal(18, 4)
  unit       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, productId])
  @@index([businessId])
  @@index([recipeId])
  @@index([productId])
}

model InventoryBalance {
