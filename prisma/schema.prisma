generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                  String                     @id @default(cuid())
  name                String
  legalName           String?
  type                String
  country             String
  baseCurrency        String
  language            String
  timezone            String
  status              BusinessStatus             @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  logoUrl             String?
  accounts            Account[]
  taxConfiguration    TaxConfiguration?
  paymentAttempts     PaymentAttempt[]
  auditEvents         AuditEvent[]
  branches            Branch[]
  events              BusinessEvent[]
  memberships         BusinessMembership[]
  referenceCounters   BusinessReferenceCounter[]
  invitations         BusinessUserInvitation[]
  customers           Customer[]
  exchangeRates       ExchangeRate[]
  expenses            Expense[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  inventoryContainers InventoryContainer[]
  journalEntries      JournalEntry[]
  operationRequests   OperationRequest[]
  payments            Payment[]
  refunds             PaymentRefund[]
  mpesaConfiguration  MpesaConfiguration?
  products            Product[]
  productCategories   ProductCategory[]
  purchases           Purchase[]
  recipes             Recipe[]
  recipeIngredients   RecipeIngredient[]
  restaurantMenus     RestaurantMenu[]
  restaurantMenuItems RestaurantMenuItem[]
  roles               Role[]
  sales               Sale[]
  saleReturns         SaleReturn[]
  suppliers           Supplier[]
  warehouses          Warehouse[]

  subscription BusinessSubscription?

  billingInvoices BillingInvoice[]
  billingPayments BillingPayment[]

  pharmacyProfile PharmacyProfile?

  supermarketProfile SupermarketProfile?

  hospitalProfile HospitalProfile?

  patients         Patient[]
  hospitalInvoices HospitalInvoice[]

  hospitalInvoicePayments HospitalInvoicePayment[]

  hospitalAppointments  HospitalAppointment[]
  hospitalEncounters    HospitalEncounter[]
  hospitalClinicalNotes HospitalClinicalNote[]
  hospitalDiagnoses     HospitalDiagnosis[]
  hospitalObservations  HospitalObservation[]

  hospitalLabOrders      HospitalLabOrder[]
  hospitalLabOrderItems  HospitalLabOrderItem[]
  hospitalLabSpecimens   HospitalLabSpecimen[]
  hospitalLabResults     HospitalLabResult[]

  hospitalLabResultRevisions HospitalLabResultRevision[]
  hospitalImagingOrders HospitalImagingOrder[]
  hospitalImagingOrderItems HospitalImagingOrderItem[]
  hospitalImagingStudies HospitalImagingStudy[]
  hospitalImagingReports HospitalImagingReport[]
  hospitalImagingReportRevisions HospitalImagingReportRevision[]

  hospitalWards       HospitalWard[]
  hospitalBeds        HospitalBed[]
  hospitalAdmissions  HospitalAdmission[]
  hospitalBedAllocations HospitalBedAllocation[]

  supermarketAutopilotActions SupermarketAutopilotAction[]

  pharmacyPrescriptions               PharmacyPrescription[]
  pharmacyControlledDispensingRecords PharmacyControlledDispensingRecord[]

  @@index([status])
}

model BusinessSubscription {
  id             String             @id @default(cuid())
  businessId     String             @unique
  plan           SubscriptionPlan
  status         SubscriptionStatus
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  startedAt      DateTime?
  endedAt        DateTime?

  billingCycle       BillingCycle?
  billingCurrency    String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  cancelAtPeriodEnd  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  invoices BillingInvoice[]
  addOns   BusinessSubscriptionAddOn[]

  @@index([status])
  @@index([trialEndsAt])
}

model BillingInvoice {
  id             String @id @default(cuid())
  businessId     String
  subscriptionId String

  invoiceNumber String
  status        BillingInvoiceStatus @default(DRAFT)

  plan         SubscriptionPlan
  billingCycle BillingCycle

  addOnCode     String?
  addOnQuantity Int?

  type BillingInvoiceType

  currency String

  subtotal    Decimal @db.Decimal(18, 4)
  taxAmount   Decimal @db.Decimal(18, 4)
  totalAmount Decimal @db.Decimal(18, 4)
  amountPaid  Decimal @default(0) @db.Decimal(18, 4)
  amountDue   Decimal @db.Decimal(18, 4)

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  periodStart DateTime?
  periodEnd   DateTime?

  // Deterministic key used only for subscription renewal invoices.
  // Nullable so non-renewal invoices are unaffected.
  renewalKey String? @unique

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription BusinessSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  items    BillingInvoiceItem[]
  payments BillingPayment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
  @@index([createdAt])
}

model BillingInvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  quantity  Decimal @default(1) @db.Decimal(18, 4)
  unitPrice Decimal @db.Decimal(18, 4)

  taxRate   Decimal @default(0) @db.Decimal(8, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 4)

  totalAmount Decimal @db.Decimal(18, 4)

  createdAt DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model BillingPayment {
  id         String @id @default(cuid())
  businessId String
  invoiceId  String

  amount   Decimal @db.Decimal(18, 4)
  currency String

  status BillingPaymentStatus @default(PENDING)

  provider          String
  providerReference String?
  providerResponse  Json?

  failureReason String?

  initiatedAt DateTime  @default(now())
  processedAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([businessId])
  @@index([invoiceId])
  @@index([status])
  @@index([provider])
  @@index([providerReference])
  @@index([createdAt])
}

model BillingProviderCallback {
  id String @id @default(cuid())

  provider  String
  eventKey  String
  reference String?
  payload   Json

  status      BillingProviderCallbackStatus @default(RECEIVED)
  attempts    Int                           @default(0)
  processedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, eventKey])
  @@index([status, createdAt])
  @@index([provider, reference])
}

model SubscriptionAddOn {
  id          String                       @id @default(cuid())
  code        String                       @unique
  name        String
  description String?
  billingType SubscriptionAddOnBillingType
  active      Boolean                      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions BusinessSubscriptionAddOn[]

  @@index([active])
}

model BusinessSubscriptionAddOn {
  id                     String                  @id @default(cuid())
  businessSubscriptionId String
  addOnCode              String
  quantity               Int                     @default(1)
  status                 SubscriptionAddOnStatus
  startedAt              DateTime                @default(now())
  endedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription BusinessSubscription @relation(fields: [businessSubscriptionId], references: [id], onDelete: Cascade)

  addOn SubscriptionAddOn @relation(fields: [addOnCode], references: [code])

  @@unique([businessSubscriptionId, addOnCode])
  @@index([businessSubscriptionId])
  @@index([addOnCode])
  @@index([status])
}

model HospitalProfile {
  id         String @id @default(cuid())
  businessId String @unique

  facilityName       String?
  facilityType       String?
  registrationNumber String?
  licenseNumber      String?

  country String  @default("Kenya")
  county  String?
  address String?
  phone   String?
  email   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([county])
  @@index([isActive])
}

model Patient {
  id         String @id @default(cuid())
  businessId String

  patientNumber String
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime?
  sex           String?
  phone         String?
  email         String?
  address       String?

  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hospitalInvoices HospitalInvoice[]

  hospitalAppointments  HospitalAppointment[]
  hospitalEncounters    HospitalEncounter[]
  hospitalClinicalNotes HospitalClinicalNote[]
  hospitalDiagnoses     HospitalDiagnosis[]
  hospitalObservations  HospitalObservation[]
  hospitalPrescriptions PharmacyPrescription[]
  hospitalLabOrders HospitalLabOrder[]
  hospitalImagingOrders HospitalImagingOrder[]
  hospitalAdmissions HospitalAdmission[]

  @@unique([businessId, patientNumber])
  @@unique([businessId, id])
  @@index([businessId])
  @@index([businessId, lastName, firstName])
  @@index([phone])
  @@index([email])
}

model HospitalAppointment {
  id                String                    @id @default(cuid())
  businessId        String
  patientId         String
  appointmentNumber String
  clinicianId       String?
  scheduledStart    DateTime
  scheduledEnd      DateTime
  reason            String
  notes             String?
  status            HospitalAppointmentStatus @default(SCHEDULED)
  createdBy         String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  business                Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient                 Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounters              HospitalEncounter[]
  followUpFromEncounterId String?
  followUpFromEncounter   HospitalEncounter?  @relation("HospitalEncounterFollowUps", fields: [followUpFromEncounterId], references: [id], onDelete: SetNull)

  @@unique([businessId, appointmentNumber])
  @@index([businessId, scheduledStart])
  @@index([businessId, patientId, scheduledStart])
  @@index([businessId, clinicianId, scheduledStart])
  @@index([businessId, status, scheduledStart])
  @@index([businessId, followUpFromEncounterId])
}

model HospitalEncounter {
  id              String                  @id @default(cuid())
  businessId      String
  patientId       String
  appointmentId   String?
  encounterNumber String
  type            HospitalEncounterType
  status          HospitalEncounterStatus @default(OPEN)
  clinicianId     String?
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  completedAt     DateTime?

  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment          HospitalAppointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  followUpAppointments HospitalAppointment[]  @relation("HospitalEncounterFollowUps")
  clinicalNotes        HospitalClinicalNote[]
  diagnoses            HospitalDiagnosis[]
  observations         HospitalObservation[]
  prescriptions        PharmacyPrescription[]
  labOrders HospitalLabOrder[]
  imagingOrders HospitalImagingOrder[]
  hospitalAdmissions HospitalAdmission[]

  @@unique([businessId, encounterNumber])
  @@unique([businessId, id])
  @@index([businessId, patientId, createdAt])
  @@index([businessId, appointmentId])
  @@index([businessId, status, createdAt])
  @@index([businessId, clinicianId, createdAt])
}

model HospitalClinicalNote {
  id          String   @id @default(cuid())
  businessId  String
  patientId   String
  encounterId String
  authorId    String
  noteType    String   @default("PROGRESS")
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter HospitalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([businessId, encounterId, createdAt])
  @@index([businessId, patientId, createdAt])
  @@index([businessId, authorId, createdAt])
}

model HospitalDiagnosis {
  id             String   @id @default(cuid())
  businessId     String
  patientId      String
  encounterId    String
  authorId       String
  code           String?
  description    String
  classification String?
  createdAt      DateTime @default(now())

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter HospitalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([businessId, encounterId, createdAt])
  @@index([businessId, patientId, createdAt])
  @@index([businessId, code])
}

model HospitalObservation {
  id              String   @id @default(cuid())
  businessId      String
  patientId       String
  encounterId     String
  authorId        String
  observationType String
  value           String
  numericValue    Decimal? @db.Decimal(18, 4)
  unit            String?
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter HospitalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([businessId, encounterId, observedAt])
  @@index([businessId, patientId, observedAt])
  @@index([businessId, observationType, observedAt])
}

model HospitalLabOrder {
  id                String                 @id @default(cuid())
  businessId        String
  patientId         String
  encounterId       String
  orderNumber       String
  orderedBy         String
  priority          HospitalLabPriority    @default(ROUTINE)
  status            HospitalLabOrderStatus @default(ORDERED)
  clinicalIndication String?
  notes             String?
  orderedAt         DateTime               @default(now())
  cancelledAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter HospitalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  items     HospitalLabOrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId, patientId, orderedAt])
  @@index([businessId, encounterId, orderedAt])
  @@index([businessId, status, orderedAt])
}

model HospitalLabOrderItem {
  id             String                @id @default(cuid())
  businessId     String
  orderId        String
  testCode       String?
  testName       String
  specimenType   String
  status         HospitalLabItemStatus @default(ORDERED)
  instructions   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order     HospitalLabOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  specimens HospitalLabSpecimen[]
  results   HospitalLabResult[]

  @@index([businessId, orderId])
  @@index([businessId, testCode])
  @@index([businessId, status])
}

model HospitalLabSpecimen {
  id               String                @id @default(cuid())
  businessId       String
  orderItemId      String
  specimenNumber   String
  specimenType     String
  status           HospitalSpecimenStatus @default(PENDING)
  collectedBy      String?
  collectedAt      DateTime?
  receivedAt       DateTime?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem HospitalLabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  results   HospitalLabResult[]

  @@unique([businessId, specimenNumber])
  @@index([businessId, orderItemId, createdAt])
  @@index([businessId, status, createdAt])
}

model HospitalLabResult {
  id                String                  @id @default(cuid())
  businessId        String
  orderItemId       String
  specimenId        String?
  resultValue       String                  @db.Text
  numericValue      Decimal?                @db.Decimal(18, 4)
  unit              String?
  referenceRange    String?
  abnormalFlag      String?
  status            HospitalLabResultStatus @default(DRAFT)
  enteredBy         String
  verifiedBy        String?
  verifiedAt        DateTime?
  releasedBy        String?
  releasedAt        DateTime?
  amendmentReason   String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  revisions HospitalLabResultRevision[]

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem HospitalLabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  specimen  HospitalLabSpecimen? @relation(fields: [specimenId], references: [id], onDelete: SetNull)

  @@index([businessId, orderItemId, createdAt])
  @@index([businessId, specimenId])
  @@index([businessId, status, createdAt])
}

model HospitalLabResultRevision {
  id          String   @id @default(cuid())
  businessId  String
  resultId    String
  revision    Int
  resultValue String   @db.Text
  numericValue Decimal? @db.Decimal(18, 4)
  unit        String?
  referenceRange String?
  abnormalFlag String?
  status      HospitalLabResultStatus
  amendedBy   String
  amendmentReason String
  createdAt   DateTime @default(now())

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  result   HospitalLabResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([businessId, resultId, revision])
  @@index([businessId, resultId, createdAt])
}


model HospitalImagingOrder {
  id              String                     @id @default(cuid())
  businessId      String
  patientId       String
  encounterId     String
  orderNumber     String
  orderedBy       String
  priority        HospitalImagingPriority    @default(ROUTINE)
  status          HospitalImagingOrderStatus @default(ORDERED)
  clinicalIndication String?
  notes           String?
  orderedAt       DateTime                   @default(now())
  cancelledAt     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter HospitalEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  items    HospitalImagingOrderItem[]

  @@unique([businessId, orderNumber])
  @@index([businessId, patientId, orderedAt])
  @@index([businessId, encounterId, orderedAt])
  @@index([businessId, status, orderedAt])
}

model HospitalImagingOrderItem {
  id          String                  @id @default(cuid())
  businessId  String
  orderId     String
  studyName   String
  modality    String
  bodySite    String
  laterality  String?
  instructions String?
  status      HospitalImagingItemStatus @default(ORDERED)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    HospitalImagingOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  studies  HospitalImagingStudy[]
  reports  HospitalImagingReport[]

  @@index([businessId, orderId, createdAt])
  @@index([businessId, modality, status, createdAt])
}

model HospitalImagingStudy {
  id          String                    @id @default(cuid())
  businessId  String
  orderItemId String
  studyNumber String
  status      HospitalImagingStudyStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  performedBy String?
  location    String?
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem HospitalImagingOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  reports   HospitalImagingReport[]

  @@unique([businessId, studyNumber])
  @@index([businessId, orderItemId, createdAt])
  @@index([businessId, status, scheduledAt])
}

model HospitalImagingReport {
  id               String                     @id @default(cuid())
  businessId       String
  orderItemId      String
  studyId          String?
  findings         String                     @db.Text
  impression       String                     @db.Text
  recommendations  String?                    @db.Text
  status           HospitalImagingReportStatus @default(DRAFT)
  enteredBy        String
  verifiedBy       String?
  verifiedAt       DateTime?
  releasedBy       String?
  releasedAt       DateTime?
  amendmentReason  String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  business Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderItem HospitalImagingOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  study    HospitalImagingStudy?     @relation(fields: [studyId], references: [id], onDelete: Restrict)
  revisions HospitalImagingReportRevision[]

  @@index([businessId, orderItemId, createdAt])
  @@index([businessId, studyId])
  @@index([businessId, status, createdAt])
}

model HospitalImagingReportRevision {
  id              String                     @id @default(cuid())
  businessId      String
  reportId        String
  revision        Int
  findings        String                     @db.Text
  impression      String                     @db.Text
  recommendations String?                    @db.Text
  status          HospitalImagingReportStatus
  amendedBy       String
  amendmentReason String
  createdAt       DateTime                   @default(now())

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  report   HospitalImagingReport @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@unique([businessId, reportId, revision])
  @@index([businessId, reportId, createdAt])
}

model HospitalWard {
  id          String   @id @default(cuid())
  businessId  String
  code        String
  name        String
  type        HospitalWardType @default(GENERAL)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  beds     HospitalBed[]

  @@unique([businessId, code])
  @@unique([businessId, id])
  @@index([businessId, isActive, name])
}

model HospitalBed {
  id          String            @id @default(cuid())
  businessId  String
  wardId      String
  bedNumber   String
  status      HospitalBedStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ward HospitalWard @relation(fields: [businessId, wardId], references: [businessId, id], onDelete: Restrict)
  allocations HospitalBedAllocation[]

  @@unique([businessId, wardId, bedNumber])
  @@index([businessId, status])
  @@unique([businessId, id])
  @@index([businessId, wardId, status])
}

model HospitalAdmission {
  id              String                  @id @default(cuid())
  businessId      String
  patientId       String
  encounterId     String?
  admissionNumber String
  status          HospitalAdmissionStatus @default(ADMITTED)
  admittedAt      DateTime                @default(now())
  dischargedAt    DateTime?
  admissionReason String?
  dischargeNotes  String?
  clinicianId     String?
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  business    Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [businessId, patientId], references: [businessId, id], onDelete: Restrict)
  encounter HospitalEncounter? @relation(fields: [businessId, encounterId], references: [businessId, id], onDelete: Restrict)
  allocations HospitalBedAllocation[]

  @@unique([businessId, admissionNumber])
  @@unique([businessId, id])
  @@index([businessId, status, admittedAt])
  @@index([businessId, patientId, admittedAt])
  @@index([businessId, encounterId])
}

model HospitalBedAllocation {
  id          String    @id @default(cuid())
  businessId  String
  admissionId String
  bedId       String
  allocatedAt DateTime  @default(now())
  releasedAt  DateTime?
  allocatedBy String
  releasedBy  String?
  releaseReason String?
  createdAt   DateTime  @default(now())

  business  Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  admission HospitalAdmission @relation(fields: [businessId, admissionId], references: [businessId, id], onDelete: Restrict)
  bed HospitalBed @relation(fields: [businessId, bedId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, admissionId, allocatedAt])
  @@index([businessId, bedId, releasedAt])
}

model HospitalInvoice {
  id            String                @id @default(cuid())
  businessId    String
  patientId     String
  invoiceNumber String
  status        HospitalInvoiceStatus @default(DRAFT)
  currency      String
  subtotal      Decimal               @db.Decimal(18, 4)
  discountTotal Decimal               @default(0) @db.Decimal(18, 4)
  taxTotal      Decimal               @default(0) @db.Decimal(18, 4)
  totalAmount   Decimal               @db.Decimal(18, 4)
