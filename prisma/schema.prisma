generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id                  String                     @id @default(cuid())
  name                String
  legalName           String?
  type                String
  country             String
  baseCurrency        String
  language            String
  timezone            String
  status              BusinessStatus             @default(ACTIVE)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  logoUrl             String?
  accounts            Account[]
  auditEvents         AuditEvent[]
  branches            Branch[]
  events              BusinessEvent[]
  memberships         BusinessMembership[]
  referenceCounters   BusinessReferenceCounter[]
  invitations         BusinessUserInvitation[]
  customers           Customer[]
  exchangeRates       ExchangeRate[]
  expenses            Expense[]
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  journalEntries      JournalEntry[]
  payments            Payment[]
  products            Product[]
  productCategories   ProductCategory[]
  purchases           Purchase[]
  recipes             Recipe[]
  recipeIngredients   RecipeIngredient[]
  restaurantMenus     RestaurantMenu[]
  restaurantMenuItems RestaurantMenuItem[]
  roles               Role[]
  sales               Sale[]
  suppliers           Supplier[]
  warehouses          Warehouse[]

  @@index([status])
}

model Branch {
  id             String         @id @default(cuid())
  businessId     String
  name           String
  code           String
  address        String?
  city           String?
  country        String
  currency       String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  journalEntries JournalEntry[]
  purchases      Purchase[]
  sales          Sale[]
  users          UserBranch[]
  warehouses     Warehouse[]

  @@unique([businessId, code])
  @@index([businessId])
}

model Warehouse {
  id                 String              @id @default(cuid())
  businessId         String
  branchId           String?
  name               String
  code               String
  address            String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  purchases          Purchase[]
  sales              Sale[]
  branch             Branch?             @relation(fields: [branchId], references: [id])
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([businessId])
  @@index([branchId])
}

model User {
  id             String               @id @default(cuid())
  name           String
  email          String               @unique
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  passwordHash   String?
  authIdentities AuthIdentity[]
  memberships    BusinessMembership[]
  branches       UserBranch[]
  roles          UserRole[]

  @@index([email])
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model BusinessMembership {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  isOwner    Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessUserInvitation {
  id         String    @id @default(cuid())
  businessId String
  email      String
  name       String?
  roleId     String
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@index([roleId])
}

model Role {
  id           String                   @id @default(cuid())
  businessId   String
  name         String
  description  String?
  permissions  String[]
  isSystemRole Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  invitations  BusinessUserInvitation[]
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users        UserRole[]

  @@unique([businessId, name])
  @@index([businessId])
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model UserBranch {
  userId   String
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model ProductCategory {
  id          String            @id @default(cuid())
  businessId  String
  name        String
  description String?
  parentId    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    Product[]
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")

  @@unique([businessId, name])
  @@index([businessId])
  @@index([parentId])
}

model Product {
  id                  String               @id @default(cuid())
  businessId          String
  categoryId          String?
  name                String
  sku                 String
  barcode             String?
  type                ProductType
  description         String?
  unit                String
  costPrice           Decimal              @db.Decimal(18, 4)
  sellingPrice        Decimal              @db.Decimal(18, 4)
  currency            String
  taxRate             Decimal?             @db.Decimal(8, 4)
  taxCode             String?
  trackInventory      Boolean              @default(true)
  minimumStock        Decimal?             @db.Decimal(18, 4)
  reorderLevel        Decimal?             @db.Decimal(18, 4)
  status              BusinessStatus       @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attributes          Json?
  inventoryBalances   InventoryBalance[]
  inventoryMovements  InventoryMovement[]
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category            ProductCategory?     @relation(fields: [categoryId], references: [id])
  prices              ProductPrice[]
  sellingUnits        ProductSellingUnit[]
  recipeIngredients   RecipeIngredient[]
  restaurantMenuItems RestaurantMenuItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([categoryId])
  @@index([barcode])
}

model ProductSellingUnit {
  id           String     @id @default(cuid())
  productId    String
  name         String
  quantity     Decimal    @db.Decimal(18, 4)
  unit         String
  sellingPrice Decimal    @db.Decimal(18, 4)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]

  @@index([productId])
}

model ProductPrice {
  id        String           @id @default(cuid())
  productId String
  type      ProductPriceType
  price     Decimal          @db.Decimal(18, 4)
  currency  String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([productId])
}

model RestaurantMenu {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       RestaurantMenuItem[]

  @@unique([businessId, name])
  @@index([businessId])
}

model RestaurantMenuItem {
  id           String         @id @default(cuid())
  businessId   String
  menuId       String
  productId    String?
  name         String
  description  String?
  sellingPrice Decimal        @db.Decimal(18, 4)
  currency     String
  isAvailable  Boolean        @default(true)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  recipe       Recipe?
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menu         RestaurantMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product      Product?       @relation(fields: [productId], references: [id])
  saleItems    SaleItem[]

  @@index([businessId])
  @@index([menuId])
  @@index([productId])
}

model Recipe {
  id          String             @id @default(cuid())
  businessId  String
  menuItemId  String             @unique
  name        String
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  menuItem    RestaurantMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([businessId])
}

model RecipeIngredient {
  id         String   @id @default(cuid())
  businessId String
  recipeId   String
  productId  String
  quantity   Decimal  @db.Decimal(18, 4)
  unit       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([recipeId])
  @@index([productId])
}

model InventoryBalance {
  id               String    @id @default(cuid())
  businessId       String
  productId        String
  warehouseId      String
  quantity         Decimal   @db.Decimal(18, 4)
  reservedQuantity Decimal   @default(0) @db.Decimal(18, 4)
  averageCost      Decimal   @db.Decimal(18, 4)
  currency         String
  updatedAt        DateTime  @updatedAt
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([businessId])
  @@index([warehouseId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  businessId    String
  productId     String
  warehouseId   String
  type          InventoryMovementType
  quantity      Decimal               @db.Decimal(18, 4)
  unitCost      Decimal?              @db.Decimal(18, 4)
  totalCost     Decimal?              @db.Decimal(18, 4)
  referenceType String?
  referenceId   String?
  notes         String?
  createdBy     String
  createdAt     DateTime              @default(now())
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([warehouseId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  phone       String?
  email       String?
  address     String?
  taxNumber   String?
  creditLimit Decimal? @db.Decimal(18, 4)
  currency    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales       Sale[]

  @@index([businessId])
  @@index([phone])
  @@index([email])
}

model Supplier {
  id               String     @id @default(cuid())
  businessId       String
  name             String
  phone            String?
  email            String?
  address          String?
  taxNumber        String?
  paymentTermsDays Int?
  currency         String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  purchases        Purchase[]
  business         Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([phone])
  @@index([email])
}

model Sale {
  id              String        @id @default(cuid())
  businessId      String
  branchId        String?
  customerId      String?
  referenceNumber String
  status          SaleStatus
  paymentStatus   PaymentStatus
  currency        String
  exchangeRate    Decimal?      @db.Decimal(18, 8)
  subtotal        Decimal       @db.Decimal(18, 4)
  discountAmount  Decimal       @db.Decimal(18, 4)
  taxAmount       Decimal       @db.Decimal(18, 4)
  totalAmount     Decimal       @db.Decimal(18, 4)
  notes           String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  warehouseId     String?
  payments        Payment[]
  branch          Branch?       @relation(fields: [branchId], references: [id])
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id])
  warehouse       Warehouse?    @relation(fields: [warehouseId], references: [id])
  items           SaleItem[]

  @@unique([businessId, referenceNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([customerId])
  @@index([createdAt])
  @@index([warehouseId])
}

model SaleItem {
  id             String              @id @default(cuid())
  saleId         String
  productId      String
  productName    String
  sku            String?
  quantity       Decimal             @db.Decimal(18, 4)
  unitPrice      Decimal             @db.Decimal(18, 4)
  discountAmount Decimal             @db.Decimal(18, 4)
  taxAmount      Decimal             @db.Decimal(18, 4)
  totalAmount    Decimal             @db.Decimal(18, 4)
  menuItemId     String?
  sellingUnitId  String?
  menuItem       RestaurantMenuItem? @relation(fields: [menuItemId], references: [id])
  sale           Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sellingUnit    ProductSellingUnit? @relation(fields: [sellingUnitId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([menuItemId])
  @@index([sellingUnitId])
}

model Purchase {
  id                    String         @id @default(cuid())
  businessId            String
  branchId              String?
  warehouseId           String?
  supplierId            String
  referenceNumber       String
  supplierInvoiceNumber String?
  status                PurchaseStatus
  paymentStatus         PaymentStatus
  currency              String
  exchangeRate          Decimal?       @db.Decimal(18, 8)
  subtotal              Decimal        @db.Decimal(18, 4)
  discountAmount        Decimal        @db.Decimal(18, 4)
  taxAmount             Decimal        @db.Decimal(18, 4)
  totalAmount           Decimal        @db.Decimal(18, 4)
  notes                 String?
  createdBy             String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  payments              Payment[]
  branch                Branch?        @relation(fields: [branchId], references: [id])
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier              Supplier       @relation(fields: [supplierId], references: [id])
  warehouse             Warehouse?     @relation(fields: [warehouseId], references: [id])
  items                 PurchaseItem[]

  @@unique([businessId, referenceNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id             String   @id @default(cuid())
  purchaseId     String
  productId      String
  productName    String
  sku            String?
  quantity       Decimal  @db.Decimal(18, 4)
  unitCost       Decimal  @db.Decimal(18, 4)
  discountAmount Decimal  @db.Decimal(18, 4)
  taxAmount      Decimal  @db.Decimal(18, 4)
  totalAmount    Decimal  @db.Decimal(18, 4)
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model Payment {
  id           String        @id @default(cuid())
  businessId   String
  saleId       String?
  purchaseId   String?
  reference    String
  method       String
  amount       Decimal       @db.Decimal(18, 4)
  currency     String
  exchangeRate Decimal?      @db.Decimal(18, 8)
  status       PaymentStatus @default(PAID)
  notes        String?
  createdBy    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase     Purchase?     @relation(fields: [purchaseId], references: [id])
  sale         Sale?         @relation(fields: [saleId], references: [id])

  @@unique([businessId, reference])
  @@index([businessId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([createdAt])
}

model Expense {
  id            String               @id @default(cuid())
  businessId    String
  branchId      String?
  reference     String
  category      String
  description   String
  amount        Decimal              @db.Decimal(18, 4)
  currency      String
  exchangeRate  Decimal?             @db.Decimal(18, 8)
  expenseDate   DateTime
  paymentStatus ExpensePaymentStatus @default(UNPAID)
  notes         String?
  createdBy     String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  branch        Branch?              @relation(fields: [branchId], references: [id])
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, reference])
  @@index([businessId])
  @@index([branchId])
  @@index([expenseDate])
}

model Account {
  id           String             @id @default(cuid())
  businessId   String
  code         String
  name         String
  type         AccountType
  description  String?
  isActive     Boolean            @default(true)
  isSystem     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalLines JournalEntryLine[]

  @@unique([businessId, code])
  @@index([businessId])
}

model JournalEntry {
  id          String             @id @default(cuid())
  businessId  String
  branchId    String?
  reference   String
  description String
  entryDate   DateTime
  status      JournalEntryStatus @default(POSTED)
  createdBy   String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  branch      Branch?            @relation(fields: [branchId], references: [id])
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines       JournalEntryLine[]

  @@unique([businessId, reference])
  @@index([businessId])
  @@index([branchId])
  @@index([entryDate])
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  currency       String
  exchangeRate   Decimal?     @db.Decimal(18, 8)
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountId])
}

model BusinessReferenceCounter {
  id            String                @id @default(cuid())
  businessId    String
  referenceType BusinessReferenceType
  currentValue  Int                   @default(0)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, referenceType])
  @@index([businessId])
}

model BusinessEvent {
  id         String   @id @default(cuid())
  businessId String
  type       String
  entityType String
  entityId   String
  actorId    String?
  data       Json?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  businessId String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  businessId   String
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(20, 8)
  source       String
  effectiveAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([fromCurrency, toCurrency])
  @@index([effectiveAt])
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  REVERSED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  FAILED
  REFUNDED
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  EXPIRY
}

enum ExpensePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

enum BusinessReferenceType {
  PRODUCT_SKU
  SALE
  PURCHASE
  PAYMENT
  EXPENSE
  JOURNAL_ENTRY
  INVENTORY_MOVEMENT
}

enum ProductPriceType {
  RETAIL
  WHOLESALE
  MINIMUM
  RATE_1
  RATE_2
  RATE_3
  RATE_4
}
